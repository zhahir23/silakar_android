<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_logo_humas"
                android:contentDescription="Logo Humas" />
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_logo_polri"
                android:contentDescription="Logo Polri" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="SIPKA" android:textColor="#0D1B35" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Daftar akun baru" android:textColor="#0D1B35" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Silakan lengkapi data diri Anda untuk mendaftar." android:textColor="#667085" android:textSize="12sp" />

        <TextView style="@style/SipkaFieldLabel" android:text="Nama Lengkap" />
        <EditText android:id="@+id/input_full_name" style="@style/SipkaEditText" android:hint="Masukkan nama lengkap" android:inputType="textPersonName" />

        <TextView style="@style/SipkaFieldLabel" android:text="Email" />
        <EditText android:id="@+id/input_email" style="@style/SipkaEditText" android:hint="nama@satuan.go.id" android:inputType="textEmailAddress" />

        <TextView style="@style/SipkaFieldLabel" android:text="Role / Jabatan" />
        <Spinner
            android:id="@+id/spinner_role"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/sipka_input_background"
            android:paddingHorizontal="12dp" />

        <TextView style="@style/SipkaFieldLabel" android:text="Pilih Atasan" />
        <Spinner
            android:id="@+id/spinner_supervisor"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/sipka_input_background"
            android:paddingHorizontal="12dp" />

        <TextView style="@style/SipkaFieldLabel" android:text="Kata sandi" />
        <EditText android:id="@+id/input_password" style="@style/SipkaEditText" android:hint="Masukkan kata sandi" android:inputType="textPassword" />

        <TextView style="@style/SipkaFieldLabel" android:text="Konfirmasi Kata sandi" />
        <EditText android:id="@+id/input_confirm_password" style="@style/SipkaEditText" android:hint="Ulangi kata sandi" android:inputType="textPassword" />

        <TextView
            android:id="@+id/register_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B42318"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button android:id="@+id/button_register" style="@style/SipkaPrimaryButton" android:layout_marginTop="14dp" android:text="Daftar" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sudah punya akun?" android:textColor="#667085" android:textSize="12sp" />
            <TextView android:id="@+id/link_login" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="Masuk" android:textColor="#2F69B3" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
