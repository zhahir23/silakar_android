<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/sipka_input_background" android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/activity_item_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#0D1B35" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/activity_item_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#667085" android:textSize="12sp" />
    <TextView android:id="@+id/activity_item_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#667085" android:textSize="10sp" />
</LinearLayout>
