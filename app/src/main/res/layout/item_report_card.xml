<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/sipka_input_background" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/report_card_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#0D1B35" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/report_card_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#EAF0F8" android:paddingStart="9dp" android:paddingTop="5dp" android:paddingEnd="9dp" android:paddingBottom="5dp" android:textColor="#2876A8" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/report_card_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="2" android:textColor="#667085" android:textSize="12sp" />
    <TextView android:id="@+id/report_card_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#667085" android:textSize="10sp" />
    <TextView android:id="@+id/report_card_kind" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#0D1B35" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
