<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F8FA" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SIPKA" android:textColor="#0D1B35" android:textSize="14sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#0D1B35" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/profile_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nama pengguna" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/profile_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#DCE4F0" android:textSize="13sp" />
            <TextView android:id="@+id/profile_role" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#33415A" android:padding="7dp" android:textColor="#FFFFFF" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="NRP tidak tersedia pada data akun backend" android:textColor="#B8C5D8" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="AKTIVITAS &amp; KINERJA" android:textColor="#667085" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/profile_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Memuat ringkasan…" android:textColor="#0D1B35" android:textSize="13sp" />
        <LinearLayout android:id="@+id/menu_admin_reports" style="@style/ProfileMenuRow" android:layout_marginTop="14dp" android:visibility="gone"><TextView style="@style/ProfileMenuTitle" android:text="Data Laporan Admin" /><TextView style="@style/ProfileMenuSubtitle" android:text="Lihat dan edit semua laporan anggota" /></LinearLayout>
        <LinearLayout android:id="@+id/menu_reports" style="@style/ProfileMenuRow" android:layout_marginTop="14dp"><TextView style="@style/ProfileMenuTitle" android:text="Laporan Kinerja" /><TextView style="@style/ProfileMenuSubtitle" android:text="Lihat dan pantau status laporan" /></LinearLayout>
        <LinearLayout android:id="@+id/menu_documentation" style="@style/ProfileMenuRow"><TextView style="@style/ProfileMenuTitle" android:text="Dokumentasi" /><TextView style="@style/ProfileMenuSubtitle" android:text="Dokumentasi yang terhubung ke laporan" /></LinearLayout>
        <LinearLayout android:id="@+id/menu_archive" style="@style/ProfileMenuRow"><TextView style="@style/ProfileMenuTitle" android:text="Arsip" /><TextView style="@style/ProfileMenuSubtitle" android:text="Laporan yang telah disetujui" /></LinearLayout>
        <LinearLayout android:id="@+id/menu_logs" style="@style/ProfileMenuRow"><TextView style="@style/ProfileMenuTitle" android:text="Log Aktivitas" /><TextView style="@style/ProfileMenuSubtitle" android:text="Riwayat aktivitas akun" /></LinearLayout>
        <LinearLayout android:id="@+id/menu_notifications" style="@style/ProfileMenuRow"><TextView style="@style/ProfileMenuTitle" android:text="Notifikasi" /><TextView style="@style/ProfileMenuSubtitle" android:text="Pembaruan dari atasan" /></LinearLayout>
        <Button android:id="@+id/profile_create_report" style="@style/SipkaPrimaryButton" android:layout_marginTop="12dp" android:text="+ Buat Laporan" />
        <TextView android:id="@+id/profile_logout" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="Keluar" android:textColor="#B42318" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
